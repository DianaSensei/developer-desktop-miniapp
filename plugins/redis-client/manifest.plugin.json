{
  "kind": "plugin",
  "id": "redis-client",
  "version": "0.0.0",
  "sdk": "^1.0.0",
  "entry": "REPLACED_BY_CI",
  "integrity": "REPLACED_BY_CI",
  "label": "Redis",
  "description": "Redis client: browse and edit keys (string, hash, list, set, sorted set), inspect server info, and run raw commands from a CLI console.",
  "icon": "memory-stick",
  "keywords": [
    "redis",
    "cache",
    "key-value",
    "kv",
    "hash",
    "sorted set",
    "zset",
    "ttl",
    "expire",
    "scan",
    "cli",
    "in-memory"
  ],
  "route": "/redis-client",
  "permissions": [
    "storage",
    "clipboard:read",
    "clipboard:write",
    "native",
    "service"
  ],
  "commands": [
    "mcp_"
  ],
  "hosts": [],
  "service": {
    "bin": "devtool-svc-redis",
    "methods": [
      "list-configs",
      "save-config",
      "delete-config",
      "test-connection",
      "overview",
      "scan-keys",
      "key-summary",
      "get-key",
      "memory-usage",
      "set-string",
      "set-ttl",
      "delete-keys",
      "rename-key",
      "exec",
      "client-list",
      "slowlog",
      "config-get",
      "config-set",
      "pubsub-subscribe",
      "unsubscribe",
      "publish"
    ]
  }
}
