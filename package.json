{
  "name": "devtool-plugins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "kafka-explorer plugin for DevTool — installable at runtime from developer-desktop-utils's Settings → Extensions instead of being compiled into the app. Forked from the devtool-plugins skeleton (main); see README.md.",
  "scripts": {
    "build": "vite build --config plugins/kafka-explorer/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:manifests": "node scripts/lint-manifests.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
