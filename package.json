{
  "name": "devtool-plugins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Optional DevTool plugins (Redis, RabbitMQ, Container Manager, Kafka Explorer), installable at runtime from developer-desktop-utils's Settings → Extensions instead of being compiled into the app.",
  "scripts": {
    "build": "npm run build:redis-client && npm run build:rabbit-client && npm run build:container-manager && npm run build:kafka-explorer",
    "build:redis-client": "vite build --config plugins/redis-client/vite.config.ts",
    "build:rabbit-client": "vite build --config plugins/rabbit-client/vite.config.ts",
    "build:container-manager": "vite build --config plugins/container-manager/vite.config.ts",
    "build:kafka-explorer": "vite build --config plugins/kafka-explorer/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:manifests": "node scripts/lint-manifests.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "esbuild": "^0.28.2",
    "jsdom": "^25",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
