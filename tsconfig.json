{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/components/tools/container/*": ["plugins/container-manager/ui/*"],
      "@/*": ["shared/*"]
    }
  },
  "include": ["plugins/**/*.ts", "plugins/**/*.tsx", "shared/**/*.ts", "shared/**/*.tsx"]
}
